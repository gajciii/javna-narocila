# Optional. Empty keys keep the clearly marked, deterministic demo assistant.
# OpenRouter takes precedence over OpenAI when both keys are set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional. Re-ranks similar past awards (tab "Pretekle oddaje") and powers `manage.py relevance_eval`.
# Without it, similar awards use text matching only. Only public tender/award data is sent.
GEMINI_API_KEY=
GEMINI_DECISION_MODEL=gemini-decision-1
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Demo dates use Europe/Ljubljana. SQLite/media are persisted in Docker volumes.
