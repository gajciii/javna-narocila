# Optional. Empty keys keep the clearly marked, deterministic demo assistant.
# OpenRouter takes precedence over OpenAI when both keys are set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional. Assesses subject fit for the company, re-ranks similar past awards, and powers relevance_eval.
# Subject fit sends the profile's activity, description, expertise, keywords and technologies to Google.
# No key keeps deterministic rules; similar awards then use text matching only.
GEMINI_API_KEY=
GEMINI_DECISION_MODEL=gemini-decision-1
# Dedicated pipeline: web and worker share PostgreSQL and private S3 storage.
# Empty DATABASE_URL retains the original SQLite local demo.
DATABASE_URL=
PIPELINE_REMOTE=0
PIPELINE_S3_ENDPOINT=
PIPELINE_S3_BUCKET=razpizi-documents
PIPELINE_S3_ACCESS_KEY=
PIPELINE_S3_SECRET_KEY=
# For compose.pipeline.yaml only: bind to a private/Tailscale address.
PIPELINE_BIND_IP=
POSTGRES_PASSWORD=
DJANGO_DEBUG=1
# Set a unique random signing key before hosting the administrator portal.
# DJANGO_SECRET_KEY=
SESSION_COOKIE_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Demo dates use Europe/Ljubljana. SQLite/media are persisted in Docker volumes.

# Optional email notifications (SMTP or Resend). Set recipient and enable in the application's Obvestila page.
# PUBLIC_APP_URL must be the public application origin (used in email links).
# For Resend: EMAIL_PROVIDER=resend, set RESEND_API_KEY and a verified DEFAULT_FROM_EMAIL.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
PUBLIC_APP_URL=
