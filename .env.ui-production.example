# Lokalni UI + lokalni Django + produkcijska PostgreSQL/S3 prek SSH tunela.
# Kopiraj v .env v KORENU repozitorija, ne v frontend/.
# Navodila: docs/local-ui-production.md
# Predloga nima gesel. Vrednosti ZAMENJAJ_* dopolni pred zagonom.
# POZOR: aplikacija ni samo za branje; tudi GET lahko zapisuje v bazo.
# Ne uporabljaj scripts/setup.sh ali scripts/dev.sh s to konfiguracijo.

DATABASE_URL=postgresql://ZAMENJAJ_UPORABNIKA:ZAMENJAJ_URL_KODIRANO_GESLO@127.0.0.1:55432/razpizi?connect_timeout=5
PIPELINE_REMOTE=1
PIPELINE_S3_ENDPOINT=http://127.0.0.1:9002
PIPELINE_S3_BUCKET=razpizi-documents
PIPELINE_S3_ACCESS_KEY=ZAMENJAJ_S3_ACCESS_KEY
PIPELINE_S3_SECRET_KEY=ZAMENJAJ_S3_SECRET_KEY

# Samo lokalni HTTP; produkcijskih nastavitev HTTPS ne kopiraj sem.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PUBLIC_APP_URL=
HOSTED_REQUIRE_LOGIN=0
SESSION_COOKIE_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DJANGO_TRUST_PROXY_SSL=0
DJANGO_SECURE_SSL_REDIRECT=0
# DJANGO_SECRET_KEY ostane privzeti lokalni ključ iz settings.py.
# Produkcijski podpisni ključ ni potreben za lokalni UI.

# Za spremembe videza niso potrebni plačljivi AI klici.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
