# Local Django/Vite + PostgreSQL from compose.dev.yaml.
# Copy to .env in the repository root before running setup.sh or dev.sh.
# These are public development credentials, not production credentials.
DATABASE_URL=postgresql://razpizi:razpizi-local-only@127.0.0.1:5433/razpizi_local?connect_timeout=5
PIPELINE_REMOTE=0
PIPELINE_S3_ENDPOINT=
PIPELINE_S3_BUCKET=razpizi-documents
PIPELINE_S3_ACCESS_KEY=
PIPELINE_S3_SECRET_KEY=

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PUBLIC_APP_URL=
HOSTED_REQUIRE_LOGIN=0
SESSION_COOKIE_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DJANGO_TRUST_PROXY_SSL=0
DJANGO_SECURE_SSL_REDIRECT=0
# Uses the default local signing key from settings.py.

# Empty keys keep demo/rule-based responses without paid AI calls.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
