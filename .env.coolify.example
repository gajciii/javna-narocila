# Enter these values in Coolify Environment Variables. Keep real values out of Git.
# Match this HTTPS origin to the domain assigned to frontend (container port 80).
PUBLIC_APP_URL=https://razpizi.example.com
DJANGO_SECRET_KEY=

# PostgreSQL, S3 storage, worker and scheduler run in the same Compose stack.
# Letters and digits only: the password is inserted into DATABASE_URL unencoded.
POSTGRES_PASSWORD=
PIPELINE_S3_BUCKET=razpizi-documents
PIPELINE_S3_ACCESS_KEY=
PIPELINE_S3_SECRET_KEY=

# Optional AI providers. Use the same Gemini model as the pipeline server.
GEMINI_API_KEY=
GEMINI_DECISION_MODEL=gemini-decision-1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional email notifications (SMTP or Resend). Set recipient and enable in the application's Obvestila page.
# PUBLIC_APP_URL must be the public application origin (used in email links).
# For Resend: EMAIL_PROVIDER=resend, set RESEND_API_KEY and a verified DEFAULT_FROM_EMAIL.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
