# Enter these values in Coolify Environment Variables. Keep real values out of Git.
# Match this HTTPS origin to the domain assigned to frontend (container port 80).
PUBLIC_APP_URL=https://razpizi.example.com
DJANGO_SECRET_KEY=

# Tailscale container identity. Create a pre-authorized auth key in your tailnet.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=razpizi-coolify
TAILSCALE_TARGET_IP=100.64.0.7

# Existing private PostgreSQL and S3 through the tailscale egress container.
# DATABASE_URL example: postgresql://razpizi:<encoded-password>@tailscale:55432/razpizi
DATABASE_URL=
PIPELINE_S3_ENDPOINT=http://tailscale:9002
PIPELINE_S3_BUCKET=razpizi-documents
PIPELINE_S3_ACCESS_KEY=
PIPELINE_S3_SECRET_KEY=

# Optional AI providers. Use the same Gemini model as the pipeline server.
GEMINI_API_KEY=
GEMINI_DECISION_MODEL=gemini-decision-1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
